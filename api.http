/////////////////////////---USER---/////////////////////////////

### REGISTER USER
POST http://localhost:3001/user/register
Content-Type: application/json

{
    "name": "Martin",
    "lastname": "Perez",
    "email": "example@example.com",
    "password": "Zurdo3",
    "role": "fiscal",
    "country": "Argentina",
    "preferredLanguage": "es"
}

### LOGIN USER
POST http://localhost:3001/user/login
Content-Type: application/json

{
    "email": "example3@example.com",
    "password": "Zurdo3"
}

### GET ALL USERS
GET http://localhost:3001/user/getAllUsers

### GET USER BY ID
POST http://localhost:3001/user/getUserById
Content-Type: application/json

{
    "id": "6a97f851a8aba5f959dff2d6"
}

### DELETE USER
POST http://localhost:3001/user/deleteUser
Content-Type: application/json

{
    "id": "6a97f5ed4b439f941761a0d3"
}


/////////////////////////---FISH---/////////////////////////////

### REGISTER FISH
POST http://localhost:3001/catchFish/registerFish
Content-Type: application/json

{
    "participant": "6a97f5ed4b439f941761a0d3",
    "fiscal": "6aaaa7bbdbc60b2e1098b45c",
    "species": "Dorado",
    "length": 0.50,
    "weight": 3
}

### REGISTER FISH DUPLICATION
POST http://localhost:3001/catchFish/registerFish
Content-Type: application/json

{
    "participant": "6aa988dddbc60b2e1098b45b",
    "fiscal": "6aaaa7bbdbc60b2e1098b45c",
    "species": "Dorado",
    "length": 0.50,
    "weight": 3,
    "confirmDuplicate": true
}

### DELETE MANY FISH
GET http://localhost:3001/catchFish/deleteManyFish

### GET FISH BY ID
POST http://localhost:3001/catchFish/getFishById
Content-Type: application/json

{
    "id": "6aaa8d548234fbada5060cf5"
}

### GET ALL FISH FOR USER
POST http://localhost:3001/catchFish/getAllFishForUser
Content-Type: application/json

{
    "idUser": "6aa988dddbc60b2e1098b45b"
}
